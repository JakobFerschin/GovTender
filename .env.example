# ============================================================================
# GovTender AI — Environment Variables
# Copy to ".env" and fill in only the layers you need. Never commit ".env".
#
# "Non-LLM First": Deterministic parsing, CPV matching, tech extraction, tests,
# and sandbox dry-runs work completely keyless (all variables below optional).
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Supabase (PostgreSQL + pgvector persistence & dashboard live data)
#    Required only for live persistence (`npm run ingest -- --live`) and
#    Supabase-backed API routes. Omit to run in deterministic sandbox mode.
# ----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ----------------------------------------------------------------------------
# 2. Multi-Platform Procurement Sources (EU TED, Swiss SIMAP, German evergabe)
# ----------------------------------------------------------------------------
# EU TED (Tenders Electronic Daily) — https://docs.ted.europa.eu/
# Sent as both `Authorization: Bearer <token>` and `x-api-key`.
# When unset, TedSource degrades gracefully to bundled EU/DACH fixtures.
TED_API_TOKEN=
# Override only when targeting a proxy or staging gateway.
TED_API_BASE=https://api.ted.europa.eu/v3

# Swiss SIMAP OCDS feed (leave blank to disable, or enable sandbox fixtures below)
SIMAP_FEED_URL=
SIMAP_API_KEY=

# German evergabe OCDS feed (leave blank to disable, or enable sandbox fixtures below)
EVERGABE_FEED_URL=
EVERGABE_API_KEY=

# Set to "true" to serve bundled DACH sandbox fixtures when SIMAP_FEED_URL /
# EVERGABE_FEED_URL are unset (also toggleable via `--sandbox` on the CLI).
GOVTENDER_SANDBOX_FIXTURES=false

# ----------------------------------------------------------------------------
# 3. Mistral AI — Optional Enhancement Layer (https://console.mistral.ai/)
#    Evaluated lazily: never required at import time or during deterministic
#    ingestion. Only invoked when deterministic regex tech extraction yields []
#    and `allowLlm` is enabled, or for full-document OCR extraction.
# ----------------------------------------------------------------------------
MISTRAL_API_KEY=
# Chat model for conditional tech enhancement & full-document JSON extraction.
MISTRAL_MODEL=mistral-small-latest
# Embedding model matching vector(1024) in supabase/migrations/0001_init.sql.
MISTRAL_EMBEDDING_MODEL=mistral-embed
