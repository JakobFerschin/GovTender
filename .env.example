# ----------------------------------------------------------------------------
# GovTender AI — environment variables
# Copy to ".env" and fill in. Never commit the real .env.
# ----------------------------------------------------------------------------

# Mistral AI (https://console.mistral.ai/) — required for extraction
MISTRAL_API_KEY=your_mistral_api_key_here

# Chat model used for structured extraction. 'mistral-small-latest' is a good
# speed/cost trade-off for JSON extraction; bump to 'mistral-large-latest'
# for trickier scanned documents.
MISTRAL_MODEL=mistral-small-latest

# Embedding model. Must match the vector(1024) dimension declared in the SQL
# migration (mistral-embed => 1024 dims).
MISTRAL_EMBEDDING_MODEL=mistral-embed

# Supabase (wired up in Phase 2)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
